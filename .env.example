# Google Identity Services
CAMILLA_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com

# Owner account secret — set this only in Render Environment Variables.
CAMILLA_OWNER_PASSWORD=CHANGE_ME

# Optional: use a persistent mounted path if your host provides one.
# CAMILLA_DB_PATH=/var/data/camilla.sqlite3

# Optional Gmail SMTP App Password for owner notifications.
CAMILLA_SMTP_HOST=smtp.gmail.com
CAMILLA_SMTP_PORT=465
CAMILLA_SMTP_USER=behruzoripov123vip17@gmail.com
CAMILLA_SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
